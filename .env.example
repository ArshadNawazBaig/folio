# Set your real HTTPS domain before production deployment. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false on development and preview deployments. Requires a public HTTPS URL.
NEXT_PUBLIC_INDEXABLE=false
# Optional Google Search Console ownership verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Apply missing migrations through 010 before connecting this version. See docs/ADMIN.md.
# Supabase Auth + PostgreSQL. Public values must be present at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy: start in test mode. All these values are server only.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
# Subscription variant: $25 USD/month, no setup fee or trial.
LEMON_SQUEEZY_MONTHLY_VARIANT_ID=
# Separate $25/month variant: 7-day trial AND a $1 one-time setup fee.
LEMON_SQUEEZY_TRIAL_VARIANT_ID=
# Webhook URL: https://your-domain.com/api/billing/webhook
# Apply migration 010_lemon_squeezy.sql; see docs/BILLING.md.

# Google sign-in OAuth credentials (configuration reference only).
# The app authenticates through Supabase and does not read these two variables.
# Copy their values into Supabase Authentication > Sign In / Providers > Google.
# Enable Google there; setting these values in .env alone does not enable sign-in.
# Google authorized redirect URI: use the exact callback shown in Supabase.
# Never add NEXT_PUBLIC_ to GOOGLE_CLIENT_SECRET.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# See docs/SETUP.md for redirect URLs and first super admin assignment.

# Optional document services, all SERVER ONLY. Paid download requires configured accounts.
# 64 hex characters; shared between instances. Never use a public env prefix.
DOCUMENT_RESULT_KEY=
# Google Cloud Translation Advanced service account (separate from Google login).
GOOGLE_TRANSLATION_PROJECT_ID=
GOOGLE_TRANSLATION_CLIENT_EMAIL=
# Quoted PEM value; literal \n escapes are accepted.
GOOGLE_TRANSLATION_PRIVATE_KEY=
CONVERTAPI_TOKEN=
# Per-instance attempts/day before payment, UTC reset; 0 pauses.
DOCUMENT_DAILY_BUDGET=50
