{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run assets && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts docs *.ts *.json README.md",
    "format:check": "prettier --check src tests scripts docs *.ts *.json README.md",
    "test:auth": "playwright test --config=playwright.auth.config.ts",
    "check:setup": "node scripts/check-setup.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "google-auth-library": "^11.0.2",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
